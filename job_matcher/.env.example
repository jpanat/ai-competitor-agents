# ─── LLM (Required) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
MODEL_NAME=claude-sonnet-4-6
MAX_TOKENS=4096

# ─── Search APIs ──────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...          # Job search + company research (tavily.com)
APIFY_API_KEY=apify_api_...      # LinkedIn profile scraping (apify.com) – optional

# ─── Agent Ports (A2A) ────────────────────────────────────────────────────────
ORCHESTRATOR_PORT=8000
PROFILE_PARSER_PORT=8001
JOB_DISCOVERY_PORT=8002
JOB_MATCHER_PORT=8003
RESUME_TAILOR_PORT=8004
COVER_LETTER_PORT=8005
GAP_ANALYSIS_PORT=8006
INTERVIEW_PREP_PORT=8007

# ─── MCP Server Ports ─────────────────────────────────────────────────────────
PROFILE_MCP_PORT=9001
JOB_BOARD_MCP_PORT=9002
DOCUMENT_MCP_PORT=9003
MEMORY_MCP_PORT=9004

# ─── For Docker Compose (internal service DNS) ────────────────────────────────
# AGENT_HOST=orchestrator   # uncomment when running in Docker
