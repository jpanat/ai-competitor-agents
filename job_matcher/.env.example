# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Job Board APIs (at least one recommended) ─────────────────────────────────
TAVILY_API_KEY=tvly-...            # web search + page extraction
RAPIDAPI_KEY=...                   # JSearch API — covers Indeed + LinkedIn + Glassdoor
SERPAPI_KEY=...                    # Alternative: SerpAPI Google Jobs

# ── LinkedIn profile scraping (choose one) ────────────────────────────────────
# PROXYCURL_API_KEY=...            # https://nubela.co/proxycurl
# APIFY_API_KEY=...                # https://apify.com

# ── Model settings ────────────────────────────────────────────────────────────
DEFAULT_MODEL=claude-sonnet-4-6
MAX_TOKENS=4096

# ── Agent ports (change only if you have conflicts) ──────────────────────────
ORCHESTRATOR_PORT=8000
PROFILE_PARSER_PORT=8001
JOB_DISCOVERY_PORT=8002
JOB_MATCHER_PORT=8003
RESUME_CUSTOMIZER_PORT=8004
COVER_LETTER_PORT=8005
GAP_ANALYSIS_PORT=8006
INTERVIEW_PREP_PORT=8007

# ── MCP Server ports ─────────────────────────────────────────────────────────
LINKEDIN_MCP_PORT=9001
JOB_BOARDS_MCP_PORT=9002
DOCUMENT_MCP_PORT=9003
MEMORY_MCP_PORT=9004

# ── Pipeline settings ─────────────────────────────────────────────────────────
MAX_JOBS_TO_DISCOVER=30
TOP_N_MATCHES=5
GENERATE_DOCS_FOR_TOP_N=3

# ── Memory (ChromaDB) ─────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=/tmp/job_matcher_chroma

# ── Redis (optional — for persistent shared state) ────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Docker inter-service URLs (required when running via docker-compose) ──────
# Uncomment these when using docker-compose so containers reach each other
# by Docker service name. Leave commented for local (run_local.sh) usage.
# ORCHESTRATOR_URL=http://orchestrator:8000
# PROFILE_PARSER_URL=http://profile_parser:8001
# JOB_DISCOVERY_URL=http://job_discovery:8002
# JOB_MATCHER_URL=http://job_matcher_agent:8003
# RESUME_CUSTOMIZER_URL=http://resume_customizer:8004
# COVER_LETTER_URL=http://cover_letter:8005
# GAP_ANALYSIS_URL=http://gap_analysis:8006
# INTERVIEW_PREP_URL=http://interview_prep:8007
# LINKEDIN_MCP_URL=http://linkedin_mcp:9001
# JOB_BOARDS_MCP_URL=http://job_boards_mcp:9002
# DOCUMENT_MCP_URL=http://document_mcp:9003
# MEMORY_MCP_URL=http://memory_mcp:9004
