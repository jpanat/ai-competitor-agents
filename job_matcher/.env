# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Job Board APIs (at least one recommended) ─────────────────────────────────
TAVILY_API_KEY=tvly-...            # web search + page extraction
RAPIDAPI_KEY=...                   # JSearch API — covers Indeed + LinkedIn + Glassdoor
SERPAPI_KEY=...                    # Alternative: SerpAPI Google Jobs

# ── LinkedIn profile scraping (choose one) ────────────────────────────────────
# PROXYCURL_API_KEY=...            # https://nubela.co/proxycurl
# APIFY_API_KEY=...                # https://apify.com

# ── Model settings ────────────────────────────────────────────────────────────
DEFAULT_MODEL=claude-sonnet-4-6
MAX_TOKENS=4096

# ── Agent ports (change only if you have conflicts) ──────────────────────────
ORCHESTRATOR_PORT=8000
PROFILE_PARSER_PORT=8001
JOB_DISCOVERY_PORT=8002
JOB_MATCHER_PORT=8003
RESUME_CUSTOMIZER_PORT=8004
COVER_LETTER_PORT=8005
GAP_ANALYSIS_PORT=8006
INTERVIEW_PREP_PORT=8007

# ── MCP Server ports ─────────────────────────────────────────────────────────
LINKEDIN_MCP_PORT=9001
JOB_BOARDS_MCP_PORT=9002
DOCUMENT_MCP_PORT=9003
MEMORY_MCP_PORT=9004

# ── Pipeline settings ─────────────────────────────────────────────────────────
MAX_JOBS_TO_DISCOVER=30
TOP_N_MATCHES=5
GENERATE_DOCS_FOR_TOP_N=3

# ── Memory (ChromaDB) ─────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=/tmp/job_matcher_chroma

# ── Redis (optional — for persistent shared state) ────────────────────────────
# REDIS_URL=redis://localhost:6379/0
